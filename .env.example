# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Reddit OAuth (userless / "client_credentials" flow).
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Anthropic API key for sentiment scoring (https://console.anthropic.com/).
ANTHROPIC_API_KEY=


# --- Storage ---------------------------------------------------------------
# SQLite file the local backend opens. Point at demo_corpus.db to serve the
# bundled demo without touching your working corpus.
CONSENSUS_DB=

# "local" (SQLite, default) or "supabase" (Postgres/pgvector). The Supabase
# backend has NOT been exercised against a live project — verify before trusting.
CONSENSUS_BACKEND=


# --- API guards (see api/limits.py) ----------------------------------------
# POST /subjects/query is the only endpoint that costs money: a cold run is one
# Haiku call per post plus a Sonnet synthesis. These bound the damage. Set any
# of them to 0 to disable that guard.

# Origins allowed to call the API, comma-separated. Defaults to the local dev
# servers, so an unconfigured deploy is CLOSED rather than open. In production
# set this to your deployed frontend origin, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=

# Per-IP query cap and its window (seconds). Default: 20 per hour.
QUERY_RATE_LIMIT=
QUERY_RATE_WINDOW_S=

# Global ceiling on NEW (cold) readings per UTC day — the actual spend cap.
# Cached subjects are always served and never count against it. Default: 100.
DAILY_COLD_QUERY_BUDGET=
