venv/
.env
__pycache__/
*.pyc

# Node / npm (accidental — this is a Python backend; JS deps don't belong here)
node_modules/
/package.json
/package-lock.json

# Backtest datasets (large, downloadable — not source)
data/*.csv

# Slice run artifacts + scoring cache (regenerable outputs, not source).
# (slice1_nvda.* were committed earlier; these patterns keep new ones out.)
slice2_*.png
slice2_*.json
.slice2_cache/

# Local item store (corpus + cached readings) and subject-resolver cache — the
# LocalItemStore backend; regenerable, not source. (pgvector is the prod backend.)
*.db
.subject_cache.json

# ...EXCEPT the deploy seed. This one snapshot IS shipped: it's baked into the
# Docker image and copied onto the volume on first boot (scripts/bootstrap_corpus.py),
# so a fresh deploy comes up populated instead of making every visitor pay the ~40s
# cold path. Regenerate with: cp corpus.db seed/corpus.seed.db
# Tradeoff: ~12MB binary in git, and a new blob in history each time it's refreshed.
!seed/corpus.seed.db

# Likewise the resolver cache: shipped so a fresh deploy doesn't pay a Haiku call
# to resolve "Nvidia" -> NVDA on every single query. Regenerate with:
#   cp .subject_cache.json seed/subject_cache.seed.json
!seed/subject_cache.seed.json
